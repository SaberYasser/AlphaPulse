# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.

# Alpaca API credentials (https://app.alpaca.markets — API keys page).
# The same key pair is used for market data (SIP/IEX) and the market clock/calendar.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Telegram bot token from @BotFather (looks like 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# Numeric chat id of the @YassirSaber private chat with the bot.
# Filled automatically by:  .\telegram_test.ps1 -Setup   (or: ets telegram-setup)
TELEGRAM_CHAT_ID=
